---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import Lists from '../components/Lists.astro';
import Materials from '../components/Materials.astro';
import {
  epochMilliseconds,
  formatLongDate,
  toISOString,
} from '../lib/datetime';

const allBlogEntries = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    epochMilliseconds(b.data.publishDate) -
    epochMilliseconds(a.data.publishDate),
);

const description = 'JavaScriptエンジニア。インターフェースデザインが好き。';

// OGP取得を含むページなのでCDNキャッシュを効かせる
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=600, stale-while-revalidate=86400',
);

// Astroコンテンツコレクションの型に対応
type BlogEntry = {
  title: string;
  slug: string;
  meta: string;
  description?: string;
};

const blogEntries: BlogEntry[] = allBlogEntries.map(
  (post: CollectionEntry<'blog'>) => {
    const parts = post.id.split('/');
    const slug =
      parts.length >= 2
        ? `${parts[parts.length - 2]}/${parts[parts.length - 1].replace(/\.(md|mdx)$/, '')}`
        : '';

    let description = '';
    if (post.body) {
      const cleanText = post.body
        .replace(/^import.*?;$/gm, '')
        .replace(/!\[.*?\]\(.*?\)/g, '')
        .replace(/<LinkCard.*?\/>/g, '')
        .replace(/<.*?>/g, '')
        .replace(/```[\s\S]*?```/g, '')
        .replace(/#+\s+.*?\n/g, '')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/\n\s*\n/g, '\n')
        .trim();

      // 100文字以内に切り詰め
      description =
        cleanText.length > 100
          ? cleanText.substring(0, 100) + '...'
          : cleanText;
    }

    return {
      title: post.data.title,
      slug,
      meta: `<time datetime="${toISOString(post.data.publishDate)}">
      ${formatLongDate(post.data.publishDate)}
    </time>`,
      description,
    };
  },
);
---

<Layout description={description} wide>
  <h1 class="sr-only">ryokatsu.dev — JavaScript エンジニアのブログ</h1>
  <section class="mb-12 text-lg">
    <p>都内でソフトウェアエンジニアをしています。技術系はフロントエンドネタの記事が多めです。その他に雑多な学びや思考を書いています。</p>
    <ul class="mt-4 flex gap-x-2">
      <li><a class="text-black dark:text-white underline hover:hover:no-underline" href="https://x.com/ryo__kts">X</a></li>
      <li><a class="text-black dark:text-white underline hover:hover:no-underline" href="https://github.com/ryokatsuse">GitHub</a></li>
      <li><a class="text-black dark:text-white underline hover:hover:no-underline" href="https://scrapbox.io/ryokatsu">Cosense</a></li>
    </ul>
  </section>
  <h2 class="text-2xl font-bold mb-8">ブログの記事</h2>
  <section class="mb-12">
    <Lists items={blogEntries.slice(0, 10)} />
  </section>
  <div><a class="text-black dark:text-white underline hover:hover:no-underline" href="/blog">すべての記事一覧</a></div>
  <h2 class="text-2xl font-bold mb-4 mt-12">登壇資料・作ったもの</h2>
  <p class="mb-8">これまでの登壇資料と、個人で作ったものをまとめています。詳しくは<a class="text-black dark:text-white underline hover:hover:no-underline" href="https://scrapbox.io/ryokatsu/%E6%88%90%E6%9E%9C%E7%89%A9">成果物</a>にも書いています。</p>
  <section class="mb-12">
    <Materials />
  </section>
</Layout>
