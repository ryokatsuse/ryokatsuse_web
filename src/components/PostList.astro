---
export interface Props {
  items: {
    title: string;
    slug: string;
    /** 表示用の日付（例: 2026年6月19日） */
    date: string;
    /** datetime属性に入れるISO文字列 */
    datetime: string;
    description?: string;
  }[];
}

const { items } = Astro.props;
---

<ul class="post-list grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
  {items.map(item => (
    <li class="min-w-0">
      <a
        href={`/blog/${item.slug}`}
        rel="prefetch"
        class="post-card group relative flex h-full flex-col gap-3 overflow-hidden rounded-xl border border-gray-200 bg-white p-5 no-underline transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-neutral-700 dark:bg-neutral-900 dark:hover:border-neutral-500"
      >
        <!-- ホバー時に現れる左のアクセントライン -->
        <span
          aria-hidden="true"
          class="absolute inset-y-0 left-0 w-1 origin-top scale-y-0 bg-gradient-to-b from-sky-400 via-indigo-500 to-fuchsia-500 transition-transform duration-300 group-hover:scale-y-100 group-focus-visible:scale-y-100"
        ></span>

        <time datetime={item.datetime} class="text-xs font-bold tracking-wider text-gray-500 dark:text-neutral-400">
          {item.date}
        </time>

        <h3 class="flex items-start gap-1 text-lg font-bold leading-snug text-gray-900 dark:text-gray-50">
          <span class="min-w-0 line-clamp-2">{item.title}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="mt-1 shrink-0 -translate-x-1 opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </h3>

        {item.description && (
          <p class="text-sm leading-relaxed text-gray-600 line-clamp-3 dark:text-neutral-400">
            {item.description}
          </p>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .post-card,
  .post-card * {
    text-decoration: none !important;
  }

  .line-clamp-2,
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-2 {
    -webkit-line-clamp: 2;
  }

  .line-clamp-3 {
    -webkit-line-clamp: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card,
    .post-card * {
      transition: none;
    }

    .post-card:hover {
      transform: none;
    }
  }
</style>
