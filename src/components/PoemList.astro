---
export interface Props {
  items: {
    title: string;
    slug: string;
    /** 表示用の日付（例: 2026年7月28日） */
    date: string;
    /** datetime属性に入れるISO文字列 */
    datetime: string;
  }[];
}

const { items } = Astro.props;
---

<ul class="grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
  {items.map(item => (
    <li class="min-w-0">
      <a
        href={`/poems/${item.slug}`}
        rel="prefetch"
        class="poem-card group flex h-full flex-col gap-3 rounded-xl border border-gray-200 bg-white p-5 no-underline transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:border-neutral-700 dark:bg-neutral-900 dark:hover:border-neutral-500"
      >
        <time datetime={item.datetime} class="text-xs tracking-wider text-gray-500 dark:text-neutral-400">
          {item.date}
        </time>
        <span class="flex items-start gap-1 text-base font-bold leading-relaxed text-gray-900 dark:text-gray-50">
          <span class="min-w-0">{item.title}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="mt-1 shrink-0 -translate-x-1 opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .poem-card,
  .poem-card * {
    text-decoration: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .poem-card,
    .poem-card * {
      transition: none;
    }

    .poem-card:hover {
      transform: none;
    }
  }
</style>
